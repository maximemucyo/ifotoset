# ---------------------------------------------------------------------------
# ifotoset environment. Copy to .env and fill in. Values shown are the
# production shape; README "Getting Started" lists the local overrides.
# ---------------------------------------------------------------------------

APP_NAME=ifotoset
APP_ENV=production
APP_KEY=                       # php artisan key:generate (required, no fallback)
APP_DEBUG=false
APP_URL=https://ifotoset.com
APP_TIMEZONE=UTC

# Public hostnames: photographer sites live at https://{username}.ROOT_DOMAIN
PROTOCOL=https
ROOT_DOMAIN=ifotoset.com
PUBLIC_ROOT_HOST=
PUBLIC_ROOT_PORT=

# Only these proxies may set X-Forwarded-For. Empty = loopback + Cloudflare
# ranges (config/proxies.php). "*" trusts everyone (unsafe, disables IP throttles).
TRUSTED_PROXIES=

# --- Database / Redis ------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ifotoset
DB_USERNAME=ifotoset_user
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# There are no sessions/cache/jobs tables: keep these on Redis.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=                # leave empty: cookies stay host-only per subdomain
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Stateful (session) API origins. Empty = localhost, APP_URL host, ROOT_DOMAIN and *.ROOT_DOMAIN
SANCTUM_STATEFUL_DOMAINS=
ALLOWED_ORIGINS=https://ifotoset.com,https://www.ifotoset.com

# --- Logging ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# --- Mail (Resend) ---------------------------------------------------------
MAIL_MAILER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=         # required, or the resend/webhook route is unauthenticated
MAIL_FROM_ADDRESS=noreply@ifotoset.com
MAIL_FROM_NAME=ifotoset
MAIL_NOTIFICATIONS_ADDRESS=notifications@ifotoset.com
MAIL_NOTIFICATIONS_NAME="ifotoset Notifications"
# Comma-separated recipients for operational alerts (failed jobs, failed payments, signups)
ADMIN_ALERT_EMAILS=

# --- Storage (Backblaze B2 behind the Cloudflare Worker) -------------------
FILESYSTEM_DISK=b2
BACKBLAZE_B2_KEY_ID=
BACKBLAZE_B2_APPLICATION_KEY=
BACKBLAZE_B2_REGION=us-east-005
BACKBLAZE_B2_BUCKET=ifotoset
BACKBLAZE_B2_ENDPOINT=
BACKBLAZE_B2_PUBLIC_ENDPOINT=
CLOUDFLARE_CDN_DOMAIN=cdn.ifotoset.com
CLOUDFLARE_CDN_SECRET=         # must equal the Worker's CDN_SECRET secret
CDN_PROTOCOL=https
CDN_HLS_STREAMING=true
USE_CDN_DOWNLOADS=true
TRASH_RETENTION_DAYS=7
CLOUDFLARE_ZONE_ID=            # optional: purge cached gallery pages
CLOUDFLARE_API_TOKEN=

# --- Media processing ------------------------------------------------------
MEDIA_QUEUE=media
MEDIA_FFMPEG_THREADS=2

# --- Payments (PawaPay) ----------------------------------------------------
PAWAPAY_API_URL=https://api.pawapay.io/v2
PAWAPAY_JWT=
PAWAPAY_CURRENCY=RWF
PAWAPAY_COUNTRY=RWA
PAWAPAY_WEBHOOK_SECRET=
IFOTOSET_RELAY_SECRET=         # shared with the callback relay (required, no fallback)
PAWAPAY_REQUIRE_CALLBACK_AUTH=false

# --- Google ----------------------------------------------------------------
GOOGLE_ANALYTICS_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty = https://ROOT_DOMAIN/google-photos/callback (register that URL in Google Cloud)
GOOGLE_REDIRECT_URI=
